# Publishable key only. Never put service-role/secret keys in this application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Real, stable HTTPS production origin used on printed QR labels.
APP_BASE_URL=
# Optional read-only Sheets connector, SERVER ONLY. Share only the source file
# with this service account as Viewer. Never make the source publicly readable.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# SERVER ONLY: approved source IDs by workspace; fail closed if missing.
# JSON shape: {"workspace-uuid":["spreadsheet-id"]}
GOOGLE_SHEETS_ALLOWED_SOURCES={}
